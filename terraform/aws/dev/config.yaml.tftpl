# Rendered by terraform/aws/dev into the app bucket, and downloaded by the Lambda at
# the start of every run. Edit the template, not the bucket object: the next apply
# overwrites it. Webhook URLs come from Secrets Manager, never from this file.
slack:
  webhook_env: SLACK_WEBHOOK_URL
  routine_webhook_env: SLACK_ROUTINE_WEBHOOK_URL
  # The routine reports of every cloud fill in one message. Each job adds its own section.
  shared_message:
    cloud: aws
    clouds: [aws, azure, gcp]
    channel: ${slack_channel_id}
    bot_token_env: SLACK_BOT_TOKEN
    time_zone: ${time_zone}
  # Each alert is a thread: reminders go in it, and it turns green when the metric recovers.
  alert_threads:
    channel: ${slack_channel_id}
    bot_token_env: SLACK_BOT_TOKEN
  cooldown_minutes: 60
  max_alerts_per_run: 10

state:
  path: s3://${bucket}/state/alerts.json

actions_file: /var/task/config/actions.yaml

defaults:
  lookback: 24h
  period: 5m
  detector: mad
  min_points: 30
  sustained_points: 3

# Each metric costs about $0.09 a month at a 5 minute schedule. Keep this list to
# the ones that would change what you do. These watch the function itself.
metrics:
  # The alert job runs every 5 minutes, so one invocation lands in each period. Three empty
  # periods in a row mean the schedule has stopped. One or two missed runs stay quiet.
  - name: lambda-invocations
    provider: aws
    region: ${region}
    namespace: AWS/Lambda
    metric: Invocations
    dimensions: {FunctionName: ${function_name}}
    stat: Sum
    category: availability
    direction: drop
    fill_missing: zero
    min_abs_change: 1

  # A run takes about 1.3 seconds, and a cold start about 4. The timeout is 300 seconds, so only
  # a rise of 30 seconds or more (in milliseconds) is worth a message.
  - name: lambda-duration
    provider: aws
    region: ${region}
    namespace: AWS/Lambda
    metric: Duration
    dimensions: {FunctionName: ${function_name}}
    stat: Average
    category: latency
    direction: spike
    min_abs_change: 30000

  - name: lambda-errors
    provider: aws
    region: ${region}
    namespace: AWS/Lambda
    metric: Errors
    dimensions: {FunctionName: ${function_name}}
    stat: Sum
    category: errors
    direction: spike
    fill_missing: zero
    min_abs_change: 1

  # Account-wide audit events from the platform-audit trail (terraform/aws/org audit.tf). Each
  # match counts 1, and any count above zero alerts. Each adds about $0.015 a month in reads.
  # CloudTrail delivers events 5 to 15 minutes late, counted at the time they happened. The job
  # reads these once per 30 minute period and alerts on either of the last two, so a late event
  # is caught on the next read, and reads (which CloudWatch bills) drop from 12 to 2 an hour.
  - name: aws-RootOrNoMfaSignIn  # the root user did something, or someone signed in without MFA
    provider: aws
    region: ${region}
    namespace: PlatformAudit
    metric: RootOrNoMfaSignIn
    stat: Sum
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

  - name: aws-IamChanges  # IAM or Organizations changed (Terraform applies count too)
    provider: aws
    region: ${region}
    namespace: PlatformAudit
    metric: IamChanges
    stat: Sum
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: warning

  - name: aws-AccessKeyCreated  # an access key or console password created: the account has no IAM users
    provider: aws
    region: ${region}
    namespace: PlatformAudit
    metric: AccessKeyCreated
    stat: Sum
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

  - name: aws-LoggingChanged  # the trail or its log group changed: logs could stop arriving
    provider: aws
    region: ${region}
    namespace: PlatformAudit
    metric: LoggingChanged
    stat: Sum
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

  - name: aws-MadePublic  # a security group opened, or an S3 public access block removed
    provider: aws
    region: ${region}
    namespace: PlatformAudit
    metric: MadePublic
    stat: Sum
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

  - name: aws-OutsideHomeRegion  # a change in a region other than ${region}
    provider: aws
    region: ${region}
    namespace: PlatformAudit
    metric: OutsideHomeRegion
    stat: Sum
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: warning

  - name: aws-KmsKeyDisabled  # a KMS key disabled or scheduled for deletion
    provider: aws
    region: ${region}
    namespace: PlatformAudit
    metric: KmsKeyDisabled
    stat: Sum
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

# The report shows month to date against a monthly budget, and warns at 80% or when the
# month is on pace to pass it. With more than one member account it also lists each one.
cost:
  lag_days: 1
  accounts:
    - name: aws-main
      provider: aws
      budget: 5
