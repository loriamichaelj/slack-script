# Rendered by terraform/azure/dev into every job's ANOMALY_CONFIG_B64 setting, so a change
# here applies on the next apply with no image deploy. Edit the template, not the setting:
# the next apply overwrites it. Webhook URLs come from Key Vault, never from this file.
slack:
  webhook_env: SLACK_WEBHOOK_URL
  routine_webhook_env: SLACK_ROUTINE_WEBHOOK_URL
  # The routine reports of every cloud fill in one message. Each job adds its own section.
  shared_message:
    cloud: azure
    clouds: [aws, azure, gcp]
    channel: ${slack_channel_id}
    bot_token_env: SLACK_BOT_TOKEN
    time_zone: ${time_zone}
  cooldown_minutes: 60
  max_alerts_per_run: 10

state:
  path: ${state_url}

actions_file: /app/config/actions.yaml

defaults:
  lookback: 24h
  period: 5m
  detector: mad
  min_points: 30
  sustained_points: 3

# Keep this list to the metrics that would change what you do. It starts with a dead-man's
# switch: the alert job reads and writes its cooldown state in this storage account every
# 5 minutes, so the account should always see transactions. If that drops to zero for 15
# minutes, the schedule has stopped.
metrics:
  - name: state-account-transactions
    provider: azure
    resource_id: ${state_account_id}
    metric: Transactions
    aggregation: total
    category: availability
    direction: drop
    fill_missing: zero
    min_abs_change: 1

  # Subscription-wide events from the Activity Log (terraform/azure/org). Each query's rows are
  # counted per period, and any count above zero alerts. The log reaches the workspace 5 to 15
  # minutes late, counted at the time it happened, so 30 minute periods leave room for late
  # rows: only complete periods are tested.
  - name: azure-role-changes  # role assignments or role definitions changed (Terraform applies count too)
    provider: azure
    workspace_id: ${audit_workspace_id}
    query: >-
      AzureActivity | where OperationNameValue in~ ("Microsoft.Authorization/roleAssignments/write", "Microsoft.Authorization/roleAssignments/delete", "Microsoft.Authorization/roleDefinitions/write", "Microsoft.Authorization/roleDefinitions/delete") and ActivityStatusValue in~ ("Success", "Succeeded")
    lookback: 3h
    period: 30m
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: warning

  - name: azure-logging-changed  # a diagnostic setting or a workspace changed or deleted: logs could stop arriving
    provider: azure
    workspace_id: ${audit_workspace_id}
    query: >-
      AzureActivity | where OperationNameValue in~ ("Microsoft.Insights/diagnosticSettings/write", "Microsoft.Insights/diagnosticSettings/delete", "Microsoft.OperationalInsights/workspaces/delete") and ActivityStatusValue in~ ("Success", "Succeeded")
    lookback: 3h
    period: 30m
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

  - name: azure-network-exposure  # a network security rule or a public IP address created or changed
    provider: azure
    workspace_id: ${audit_workspace_id}
    query: >-
      AzureActivity | where OperationNameValue in~ ("Microsoft.Network/networkSecurityGroups/securityRules/write", "Microsoft.Network/publicIPAddresses/write") and ActivityStatusValue in~ ("Success", "Succeeded")
    lookback: 3h
    period: 30m
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

  - name: azure-key-vault-changed  # a Key Vault, or who may read it, changed or deleted
    provider: azure
    workspace_id: ${audit_workspace_id}
    query: >-
      AzureActivity | where OperationNameValue in~ ("Microsoft.KeyVault/vaults/write", "Microsoft.KeyVault/vaults/delete", "Microsoft.KeyVault/vaults/accessPolicies/write") and ActivityStatusValue in~ ("Success", "Succeeded")
    lookback: 3h
    period: 30m
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: warning

  - name: azure-new-footprint  # a resource group created or deleted
    provider: azure
    workspace_id: ${audit_workspace_id}
    query: >-
      AzureActivity | where OperationNameValue in~ ("Microsoft.Resources/subscriptions/resourceGroups/write", "Microsoft.Resources/subscriptions/resourceGroups/delete") and ActivityStatusValue in~ ("Success", "Succeeded")
    lookback: 3h
    period: 30m
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: warning

  - name: azure-security-alerts  # a Defender for Cloud security alert
    provider: azure
    workspace_id: ${audit_workspace_id}
    query: >-
      AzureActivity | where CategoryValue == "Security"
    lookback: 3h
    period: 30m
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

  - name: azure-service-health  # an Azure incident or planned maintenance that affects this subscription
    provider: azure
    workspace_id: ${audit_workspace_id}
    query: >-
      AzureActivity | where CategoryValue == "ServiceHealth"
    lookback: 3h
    period: 30m
    category: availability
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: warning

# The report shows month to date against a monthly budget, and warns at 80% or when the
# month is on pace to pass it.
cost:
  lag_days: 1
  accounts:
    - name: azure-sub
      provider: azure
      scope: ${subscription_scope}
      budget: ${budget}
