# Rendered by terraform/gcp/dev and mounted into every job. Edit the template, not
# the bucket object: the next apply overwrites it.
slack:
  webhook_env: SLACK_WEBHOOK_URL
  routine_webhook_env: SLACK_ROUTINE_WEBHOOK_URL
  # The routine reports of every cloud fill in one message. Each job adds its own section.
  shared_message:
    cloud: gcp
    clouds: [aws, azure, gcp]
    channel: ${slack_channel_id}
    bot_token_env: SLACK_BOT_TOKEN
    time_zone: ${time_zone}
  # Each alert is a thread: reminders go in it, and it turns green when the metric recovers.
  alert_threads:
    channel: ${slack_channel_id}
    bot_token_env: SLACK_BOT_TOKEN
  cooldown_minutes: 60
  max_alerts_per_run: 10

state:
  path: ${mount_path}/state/alerts.json

# The alert job runs every 10 minutes on GCP (terraform/gcp/dev/jobs.tf). Metrics read once per
# period (`every`) use this to know which run is the first after each boundary.
run_every: 10m

actions_file: /app/config/actions.yaml

defaults:
  lookback: 24h
  period: 5m
  detector: mad
  min_points: 30
  sustained_points: 3

# Both metrics query the scoping project, whose metrics scope covers the whole org,
# and split by project so each project alerts on its own.
metrics:
  - name: org-error-logs
    provider: gcp
    project: ${project_id}
    metric_type: logging.googleapis.com/log_entry_count
    filter: 'metric.labels.severity = "ERROR"'
    aligner: ALIGN_DELTA
    group_by: [resource.labels.project_id]
    category: errors
    direction: spike
    fill_missing: zero
    min_abs_change: 10

  - name: org-api-errors
    provider: gcp
    project: ${project_id}
    metric_type: serviceruntime.googleapis.com/api/request_count
    filter: 'metric.labels.response_code_class = "5xx"'
    aligner: ALIGN_DELTA
    group_by: [resource.labels.project_id]
    category: errors
    direction: spike
    fill_missing: zero
    min_abs_change: 5

  # Any Cloud Run job that finished in failure, per job. A failed run is rare, so one is enough.
  - name: cloud-run-job-failures
    provider: gcp
    project: ${project_id}
    metric_type: run.googleapis.com/job/completed_execution_count
    filter: 'metric.labels.result = "failed"'
    aligner: ALIGN_DELTA
    group_by: [resource.labels.job_name]
    category: errors
    direction: spike
    fill_missing: zero
    min_abs_change: 1

  # The alert job runs every 10 minutes, so one run finishes in each period. Three empty periods
  # in a row mean the schedule has stopped. One or two missed runs stay quiet.
  - name: anomaly-run-succeeded
    provider: gcp
    project: ${project_id}
    metric_type: run.googleapis.com/job/completed_execution_count
    filter: 'metric.labels.result = "succeeded" AND resource.labels.job_name = "anomaly-run"'
    aligner: ALIGN_DELTA
    period: 10m
    category: availability
    direction: drop
    fill_missing: zero
    min_abs_change: 1

  # Public sites, checked from 3 regions every 5 minutes (terraform/gcp/org uptime.tf). The
  # value is the share of regions that passed: alert when most fail for 10 minutes.
  - name: site-up
    provider: gcp
    project: ${project_id}
    metric_type: monitoring.googleapis.com/uptime_check/check_passed
    aligner: ALIGN_FRACTION_TRUE
    reducer: REDUCE_MEAN
    group_by: [resource.labels.host]
    category: availability
    detector: threshold
    threshold: 0.5
    direction: drop
    sustained_points: 2
    severity: critical

  # Audit events from every org project, as log-based metrics on the org log bucket
  # (terraform/gcp/org audit.tf). Any one alerts, split by the project it came from.
  # Log entries arrive a minute or more after they happen but count at the time they happened,
  # so the job reads these once per 30 minute period and alerts on either of the last two:
  # an entry that lands late is caught on the next read.
  - name: audit-iam-changes  # IAM or org policy changed on the org, a folder or a project
    provider: gcp
    project: ${project_id}
    metric_type: logging.googleapis.com/user/audit-iam-changes
    aligner: ALIGN_DELTA
    group_by: [metric.labels.source]
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: warning

  - name: audit-new-footprint  # project created, moved or deleted, or an API turned on
    provider: gcp
    project: ${project_id}
    metric_type: logging.googleapis.com/user/audit-new-footprint
    aligner: ALIGN_DELTA
    group_by: [metric.labels.source]
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: warning

  - name: audit-sa-key-created  # a service account key, the credential most often leaked
    provider: gcp
    project: ${project_id}
    metric_type: logging.googleapis.com/user/audit-sa-key-created
    aligner: ALIGN_DELTA
    group_by: [metric.labels.source]
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

  - name: audit-logging-changed  # a log sink, bucket or exclusion changed: logs could stop arriving
    provider: gcp
    project: ${project_id}
    metric_type: logging.googleapis.com/user/audit-logging-changed
    aligner: ALIGN_DELTA
    group_by: [metric.labels.source]
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

  - name: audit-made-public  # a bucket opened to everyone, or a firewall rule opened to 0.0.0.0/0
    provider: gcp
    project: ${project_id}
    metric_type: logging.googleapis.com/user/audit-made-public
    aligner: ALIGN_DELTA
    group_by: [metric.labels.source]
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

  - name: audit-kms-key-destroyed  # a KMS key version scheduled for destruction
    provider: gcp
    project: ${project_id}
    metric_type: logging.googleapis.com/user/audit-kms-key-destroyed
    aligner: ALIGN_DELTA
    group_by: [metric.labels.source]
    lookback: 3h
    period: 30m
    every: 30m
    within: 2
    category: security
    detector: threshold
    threshold: 0
    direction: spike
    sustained_points: 1
    fill_missing: zero
    severity: critical

cost:
  lag_days: 2            # the GCP billing export runs about a day behind
  accounts:
    - name: gcp-billing
      provider: gcp
      billing_table: ${billing_table}
      budget: 5
      job_project: ${project_id}  # query from here: read-only access to the table is enough
    - name: gcp-my-billing
      provider: gcp
      billing_table: ${second_billing_table}
      budget: 5
      job_project: ${project_id}
